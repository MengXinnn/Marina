{
  "name": "marina",
  "private": true,
  "type": "module",
  "description": "Manila (马尼拉) — a voxel pixel-art 3D web adaptation of the board game, local hotseat play.",
  "workspaces": [
    "packages/engine",
    "packages/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @manila/web",
    "build": "npm run build -w @manila/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
